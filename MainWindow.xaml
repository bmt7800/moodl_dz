<Window x:Class="InvoiceLedger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FinFlow — вход в систему" Height="560" Width="960"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F4F7FB">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
        <Grid Background="#173B6C">
            <Grid Margin="60">
                <StackPanel VerticalAlignment="Center">
                    <Border Width="56" Height="56" Background="#4FD1C5" CornerRadius="16" HorizontalAlignment="Left">
                        <TextBlock Text="₽" FontSize="30" FontWeight="Bold" Foreground="#173B6C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="FinFlow" FontSize="38" FontWeight="Bold" Foreground="White" Margin="0,26,0,10"/>
                    <TextBlock Text="Учет счетов и платежей\nдля вашей команды" FontSize="19" Foreground="#C8D8EF" LineHeight="30"/>
                    <Border Background="#20497D" CornerRadius="10" Padding="18" Margin="0,42,0,0">
                        <StackPanel>
                            <TextBlock Text="Все финансовые документы — в одном месте" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Text="Счета, оплаты, задолженности и аналитика." Foreground="#C8D8EF" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
        <Border Grid.Column="1" Background="White" Padding="48">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Добро пожаловать" FontSize="28" FontWeight="Bold" Foreground="#1D2939"/>
                <TextBlock Text="Войдите, чтобы управлять финансами" Foreground="#667085" Margin="0,8,0,32"/>
                <TextBlock Text="ЭЛЕКТРОННАЯ ПОЧТА" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="EmailTextBox" Style="{StaticResource InputStyle}" Text="admin@finflow.local"/>
                <TextBlock Text="ПАРОЛЬ" Style="{StaticResource LabelStyle}" Margin="0,18,0,6"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputStyle}" Password="Admin123!"/>
                <Grid Margin="0,16,0,28"><CheckBox x:Name="RememberCheckBox" Content="Запомнить меня" Foreground="#475467"/><TextBlock HorizontalAlignment="Right"><Hyperlink Click="ForgotPassword_Click" Foreground="#2563EB">Забыли пароль?</Hyperlink></TextBlock></Grid>
                <Button Content="Войти в систему" Click="Login_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                <Border x:Name="MessageBorder" Background="#FEF3F2" BorderBrush="#FECDCA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" Foreground="#B42318" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="Демо-доступ: admin@finflow.local / Admin123!" Foreground="#98A2B3" FontSize="12" TextAlignment="Center" Margin="0,28,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="InvoiceLedger.DashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FinFlow — панель управления" Height="620" Width="1050" WindowStartupLocation="CenterScreen" Background="#F8FAFC">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#173B6C" Padding="24"><StackPanel><TextBlock Text="FinFlow" FontSize="25" FontWeight="Bold" Foreground="White" Margin="0,0,0,45"/><TextBlock Text="ОБЗОР" Foreground="#8FB2E1" FontSize="11"/><Button Content="▣  Главная" Style="{StaticResource MenuButton}"/><Button Content="▤  Счета" Style="{StaticResource MenuButton}"/><Button Content="✓  Платежи" Style="{StaticResource MenuButton}"/><Button Content="◉  Контрагенты" Style="{StaticResource MenuButton}"/><Button Content="▥  Отчеты" Style="{StaticResource MenuButton}"/><TextBlock Text="Настройки" Foreground="#C8D8EF" Margin="0,35,0,0"/></StackPanel></Border>
        <Grid Grid.Column="1" Margin="36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid><StackPanel><TextBlock Text="Панель управления" FontSize="28" FontWeight="Bold" Foreground="#1D2939"/><TextBlock x:Name="WelcomeText" Foreground="#667085" Margin="0,6,0,0"/></StackPanel><Button Content="+ Новый счет" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" Width="145"/></Grid>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,30,0,22"><Border Style="{StaticResource CardStyle}" Margin="0,0,14,0"><StackPanel><TextBlock Text="К ОПЛАТЕ" Style="{StaticResource CardLabel}"/><TextBlock Text="₽ 284 500" Style="{StaticResource CardAmount}"/><TextBlock Text="12 активных счетов" Foreground="#667085" FontSize="12"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,14,0"><StackPanel><TextBlock Text="ОПЛАЧЕНО В МЕСЯЦЕ" Style="{StaticResource CardLabel}"/><TextBlock Text="₽ 156 200" Style="{StaticResource CardAmount}"/><TextBlock Text="↑ 12% к прошлому месяцу" Foreground="#12B76A" FontSize="12"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="ПРОСРОЧЕНО" Style="{StaticResource CardLabel}"/><TextBlock Text="₽ 42 800" Style="{StaticResource CardAmount}"/><TextBlock Text="3 счета требуют внимания" Foreground="#F04438" FontSize="12"/></StackPanel></Border></UniformGrid>
            <Border Grid.Row="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Последние счета" FontSize="18" FontWeight="SemiBold" Foreground="#1D2939"/><DataGrid Margin="0,18,0,0" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" ItemsSource="{Binding Invoices}"><DataGrid.Columns><DataGridTextColumn Header="НОМЕР" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="КОНТРАГЕНТ" Binding="{Binding Counterparty}" Width="2*"/><DataGridTextColumn Header="СРОК ОПЛАТЫ" Binding="{Binding DueDate, StringFormat=d}" Width="*"/><DataGridTextColumn Header="СУММА" Binding="{Binding Amount, StringFormat={}{0:N0} ₽}" Width="*"/><DataGridTextColumn Header="СТАТУС" Binding="{Binding Status}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border>
        </Grid></Grid>
</Window>
